// create the map object and set the cooridnates of the initial view:
var map = L.map('map_alumni', {fullscreenControl: true}).setView([15, 15], 2);
var createFlagIcon = function() {
  return L.icon({
    iconUrl: '/assets/images/almuni_logo_outlined.png',
    iconRetinaUrl: '/assets/images/almuni_logo_outlined.png',
    shadowUrl: '/assets/images/marker-shadow.png',
    iconSize: [41, 41], // size of the icon
    shadowSize: [41, 6], // size of the shadow
    iconAnchor: [10, 38], // point of the icon which will correspond to marker's location
    shadowAnchor: [10, 0], // the same for the shadow
    popupAnchor: [10, -20], // point from which the popup should open relative to the iconAnchor
  });
};

// create the tile layer with correct attribution:
L.tileLayer(
  'https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',}).addTo(map);

render.features.forEach(function (feature) {
  L.geoJson(feature, {
    pointToLayer: function (feature, latlng) {
      const altText = feature.properties && feature.properties.shortname ? 
                    feature.properties.shortname + "'s location" : 
                    "Alumni location";
      return L.marker(latlng, { icon: createFlagIcon(), alt: altText, opacity: 1, title: altText });
    },
    onEachFeature: onEachFeature,
  }).addTo(map);
});

function onEachFeature(feature, layer) {
  // does this feature have a property named popupContent?
  if (feature.properties) {
    layer.bindPopup(function () {
      var userstring =
        'http://githubcampus.expert/' + feature.properties.username;
      var popupstring = feature.properties.shortname + "'s profile";
      return '<a href=' + userstring + '>' + popupstring + '</a>';
    });
  }
}
